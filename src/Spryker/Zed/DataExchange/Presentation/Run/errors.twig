{% if errors | length > 0 %}
    {% if omittedErrorCount > 0 %}
        <div class="alert alert-warning">
            <i class="fa fa-exclamation-triangle"></i>
            {{ 'The error row limit was reached: only the first %stored% of %total% errors are stored. %omitted% further errors were counted but not stored.' | trans({'%stored%': errors | length, '%total%': (errors | length) + omittedErrorCount, '%omitted%': omittedErrorCount}) }}
        </div>
    {% endif %}
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>{{ 'Row #' | trans }}</th>
                <th>{{ 'Error Message' | trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for error in errors %}
                <tr>
                    <td>{{ error.csvRowNumber ?: '-' }}</td>
                    <td>{{ error.errorMessage }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% else %}
    <p class="text-success">{{ 'No errors found for this run.' | trans }}</p>
{% endif %}
