{
    "name": "spryker/data-exchange",
    "type": "library",
    "description": "DataExchange module",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "spryker/data-exchange-extension": "^0.1.0",
        "spryker/event": "^2.0.0",
        "spryker/event-behavior": "^1.30.0",
        "spryker/file-system": "^2.0.0",
        "spryker/gui": "^5.8.0",
        "spryker/kernel": "^3.30.0",
        "spryker/log": "^3.16.0",
        "spryker/propel-orm": "^1.0.0",
        "spryker/symfony": "^3.0.0",
        "spryker/transfer": "^3.27.0",
        "spryker/util-date-time": "^1.0.0",
        "spryker/util-encoding": "^2.0.0",
        "spryker/util-text": "^1.0.0"
    },
    "require-dev": {
        "spryker/code-sniffer": "*",
        "spryker/container": "*",
        "spryker/flysystem": "*",
        "spryker/flysystem-local-file-system": "*",
        "spryker/propel": "*",
        "spryker/testify": "*"
    },
    "autoload": {
        "psr-4": {
            "Spryker\\": "src/Spryker/",
            "SprykerTest\\Shared\\DataExchange\\Helper\\": "tests/SprykerTest/Shared/DataExchange/_support/Helper/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SprykerTest\\": "tests/SprykerTest/",
            "SprykerTest\\Zed\\DataExchange\\Plugin\\": "tests/SprykerTest/Zed/DataExchange/_support/Plugin/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "cs-check": "phpcs -p -s --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/ tests/",
        "cs-fix": "phpcbf -p --standard=vendor/spryker/code-sniffer/SprykerStrict/ruleset.xml src/ tests/"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
